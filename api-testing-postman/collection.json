      "name": "Buscar producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"El status HTTP es 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"El responseCode del body es 200\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.responseCode).to.eql(200);\r\n});\r\n\r\npm.test(\"Devuelve al menos un producto\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.products.length).to.be.above(0);\r\n});"
            ]
          }
        }
      ],
